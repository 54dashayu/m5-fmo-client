CONFIG_MQTT_USE_CUSTOM_CONFIG=y
CONFIG_MQTT_POLL_READ_TIMEOUT_MS=20
CONFIG_MQTT_OUTBOX_EXPIRED_TIMEOUT_MS=1500
CONFIG_LWIP_TCP_MSS=1024
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=4096
CONFIG_LWIP_TCP_WND_DEFAULT=4096

CONFIG_LV_INVERT_COLORS=y

# Dim LCD while preserving voice connectivity.
CONFIG_LV_DISP_BACKLIGHT_PWM=y
